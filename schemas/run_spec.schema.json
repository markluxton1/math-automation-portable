{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Math Automation Portable run specification",
  "type": "object",
  "required": ["id", "problem", "nodes", "provider", "model", "concurrency", "retry_limit", "jobs"],
  "properties": {
    "id": {"type": "string", "minLength": 1},
    "problem": {"type": "string", "minLength": 1},
    "nodes": {"type": "array", "items": {"type": "string"}, "minItems": 1},
    "provider": {"type": "string", "minLength": 1},
    "model": {"type": "string", "minLength": 1},
    "concurrency": {"type": "integer", "minimum": 1},
    "retry_limit": {"type": "integer", "minimum": 0},
    "output_location": {"type": "string", "minLength": 1},
    "treatment_policy": {"type": "string"},
    "jobs": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "node", "operation"],
        "properties": {
          "id": {"type": "string", "minLength": 1},
          "node": {"type": "string", "minLength": 1},
          "operation": {"enum": ["ordinary", "exploration"]},
          "count": {"type": "integer", "minimum": 1},
          "selected_artifacts": {"type": "array", "items": {"type": "string"}},
          "excluded_representations": {"type": "array", "items": {"type": "string"}},
          "independence": {"enum": ["independent", "downstream"]},
          "treatment_metadata": {"type": "object"}
        },
        "allOf": [
          {
            "if": {"properties": {"operation": {"const": "exploration"}}},
            "then": {
              "required": ["excluded_representations"],
              "properties": {"excluded_representations": {"minItems": 1}}
            }
          }
        ]
      }
    }
  },
  "additionalProperties": true
}
